# macOS
.DS_Store

# Local preview server config — machine-specific paths, no use to anyone else
.claude/

# NOTE: _deploy/ is intentionally NOT ignored.
# It is generated by make-deploy.sh, and committing build output is normally a
# bad habit — but this project has no build step, and keeping it in the repo
# means Netlify can be pointed straight at _deploy as its publish directory
# with no build command to configure or break. It is 540 KB.
